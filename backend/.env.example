NODE_ENV=development
PORT=5000

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_dashboard?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/crm_dashboard?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Comma-separated origins. Use * only for local experiments.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# debug, info, warn, error
LOG_LEVEL=info
