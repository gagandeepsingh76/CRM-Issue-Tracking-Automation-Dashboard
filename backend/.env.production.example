NODE_ENV=production
PORT=5000

# Use Neon pooled connection for app traffic.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&schema=public"

# Use Neon direct connection for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require&schema=public"

JWT_SECRET="replace-with-at-least-32-random-bytes"
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

CORS_ORIGIN=https://your-frontend.vercel.app
TRUST_PROXY=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOG_LEVEL=info

# Production seed is opt-in and creates only the first admin account.
ALLOW_PRODUCTION_SEED=false
SEED_ADMIN_NAME="CRM Admin"
SEED_ADMIN_EMAIL=admin@your-domain.example
SEED_ADMIN_PASSWORD="replace-with-a-strong-temporary-password"
