{
  "name": "crm-dashboard-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-style Express and Prisma backend for the CRM dashboard.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "node scripts/check-syntax.js",
    "test": "node --test tests/api.integration.test.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
